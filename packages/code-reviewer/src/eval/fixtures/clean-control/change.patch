 import { clsx, type ClassValue } from "clsx";
 import { twMerge } from "tailwind-merge";
 
+// Resolves conflicting Tailwind utilities (e.g. two padding classes) after merging the
+// conditional inputs, so the last one wins instead of both being emitted.
 export function cn(...inputs: ClassValue[]) {
   return twMerge(clsx(inputs));
 }
