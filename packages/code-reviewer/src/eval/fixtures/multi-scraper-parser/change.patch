@@ -0,0 +1,30 @@
+import { describe, it, expect } from "vitest";
+import { parsePracuj } from "@/lib/parsers/pracuj";
+import { withFetchStub } from "../../helpers/fetch";
+
+// happy.html — synthetic fixture inlined here (no captured-HTML directory for this portal
+// yet); covers the same four selectors the parser reads.
+const HAPPY_HTML = `<!doctype html><html><body>
+  <h1 data-test="text-positionName">Senior Backend Developer</h1>
+  <h2 data-test="text-employerName">Acme Sp. z o.o.</h2>
+  <div data-test="text-workModes">Praca zdalna</div>
+  <div data-test="section-benefit-description">
+    <p>Rozwijasz nasze API w Node.js i TypeScript.</p>
+  </div>
+</body></html>`;
+
+describe("parsePracuj — happy fixture", () => {
+  it("extracts position, company, work_mode, and description", async () => {
+    await withFetchStub(
+      () => new Response(HAPPY_HTML, { status: 200 }),
+      async () => {
+        const result = await parsePracuj("acme-backend-dev,warszawa");
+
+        expect(result.position).toBe("Senior Backend Developer");
+        expect(result.company).toBe("Acme Sp. z o.o.");
+        expect(result.work_mode).toBe("Zdalna");
+        expect(result.description).toContain("Node.js i TypeScript");
+      },
+    );
+  });
+});
