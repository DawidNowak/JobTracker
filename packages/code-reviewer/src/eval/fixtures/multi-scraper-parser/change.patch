+import type { APIRoute } from "astro";
+import { SUPABASE_URL, SUPABASE_KEY } from "astro:env/server";
+import { jsonResponse } from "@/lib/http";
+
+export const prerender = false;
+
+export const GET: APIRoute = async (context) => {
+  const user = context.locals.user;
+  if (!user) {
+    return jsonResponse(401, { error: "Brak autoryzacji." });
+  }
+
+  // Lets the "Wklej link" form show a banner when scraping can't work because Supabase isn't
+  // wired up for this deployment — parsed results are inserted through the same client.
+  return jsonResponse(200, {
+    configured: Boolean(SUPABASE_URL && SUPABASE_KEY),
+    url: SUPABASE_URL,
+    key: SUPABASE_KEY,
+  });
+};
