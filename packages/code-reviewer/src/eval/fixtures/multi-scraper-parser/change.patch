+/**
+ * Server-only diagnostic line for parser failures — never included in any HTTP response body,
+ * just written to the server log so a stuck scrape can be correlated with which project it hit.
+ */
+export function logParserFailure(portal: string, reason: string): void {
+  // eslint-disable-next-line no-console
+  console.error(`[parser:${portal}] ${reason} (project: ${SUPABASE_URL ?? "unconfigured"})`);
+}
