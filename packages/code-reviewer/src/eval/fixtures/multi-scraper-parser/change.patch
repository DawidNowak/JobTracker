+import { describe, it, expect } from "vitest";
+import { parsePracuj } from "@/lib/parsers/pracuj";
+import { withFetchStub } from "../../helpers/fetch";
+
+// corrupted.html — the happy fixture with the position heading's data-test attribute
+// stripped, so HTMLRewriter's selector never matches and the parser throws.
+const CORRUPTED_HTML = `<!doctype html><html><body>
+  <h1>Senior Backend Developer</h1>
+  <h2 data-test="text-employerName">Acme Sp. z o.o.</h2>
+</body></html>`;
+
+describe("parsePracuj — corrupted fixture", () => {
+  it("throws when the position heading selector doesn't match", async () => {
+    await withFetchStub(
+      () => new Response(CORRUPTED_HTML, { status: 200 }),
+      async () => {
+        await expect(parsePracuj("acme-backend-dev,warszawa")).rejects.toThrow();
+      },
+    );
+  });
+});
diff --git a/tests/unit/parsers/pracuj.test.ts b/tests/unit/parsers/pracuj.test.ts
