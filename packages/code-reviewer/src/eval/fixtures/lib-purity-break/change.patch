diff --git a/src/lib/notifications.ts b/src/lib/notifications.ts
new file mode 100644
index 0000000..d6b1ec5
--- /dev/null
+++ b/src/lib/notifications.ts
@@ -0,0 +1,30 @@
+import { createClient } from "@/lib/supabase";
+import type { AstroCookies } from "astro";
+
+const STALE_AFTER_DAYS = 14;
+const NUDGE_THRESHOLD = 3;
+
+/**
+ * Counts applications that have not moved status in `STALE_AFTER_DAYS` and decides whether the
+ * dashboard should show a "check your pipeline" nudge.
+ */
+export async function shouldShowStaleNudge(
+  requestHeaders: Headers,
+  cookies: AstroCookies,
+  userId: string,
+): Promise<boolean> {
+  const supabase = createClient(requestHeaders, cookies);
+  if (!supabase) return false;
+
+  const staleCutoff = new Date(Date.now() - STALE_AFTER_DAYS * 24 * 60 * 60 * 1000).toISOString();
+
+  const { data, error } = await supabase
+    .from("applications")
+    .select("id")
+    .eq("user_id", userId)
+    .is("archived_at", null)
+    .lt("last_action_at", staleCutoff);
+
+  if (error) return false;
+  return data.length >= NUDGE_THRESHOLD;
+}
