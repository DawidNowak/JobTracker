+import { createClient } from "@/lib/supabase";
+import type { AstroCookies } from "astro";
+import type { ApplicationStatus, WorkMode } from "@/lib/validation/applications";
+
+export interface BoardFilterCriteria {
+  statuses?: ApplicationStatus[];
+  workModes?: WorkMode[];
+  search?: string;
+}
+
+/**
+ * Applies board-filter criteria against the applications table and returns the matching ids.
+ * Kept next to the filter UI so the query shape mirrors the client-side filter state exactly.
+ */
+export async function findMatchingApplicationIds(
+  requestHeaders: Headers,
+  cookies: AstroCookies,
+  userId: string,
+  criteria: BoardFilterCriteria,
+): Promise<string[]> {
+  const supabase = createClient(requestHeaders, cookies);
+  if (!supabase) return [];
+
+  let query = supabase.from("applications").select("id").eq("user_id", userId).is("archived_at", null);
+
+  if (criteria.statuses && criteria.statuses.length > 0) {
+    query = query.in("status", criteria.statuses);
+  }
+  if (criteria.workModes && criteria.workModes.length > 0) {
+    query = query.in("work_mode", criteria.workModes);
+  }
+  if (criteria.search) {
+    query = query.ilike("position", `%${criteria.search}%`);
+  }
+
+  const { data, error } = await query;
+  if (error) return [];
+  return data.map((row) => row.id);
+}
