+import type { APIRoute } from "astro";
+import { createClient } from "@/lib/supabase";
+import { jsonResponse } from "@/lib/http";
+import { saveNamedFilter } from "@/lib/services/board-filters";
+
+export const prerender = false;
+
+export const POST: APIRoute = async (context) => {
+  const user = context.locals.user;
+  if (!user) {
+    return jsonResponse(401, { error: "Brak autoryzacji." });
+  }
+
+  // Small payload, shared internally only — parsed straight off the request.
+  const body = (await context.request.json()) as { name: string; criteria: Record<string, unknown> };
+
+  const supabase = createClient(context.request.headers, context.cookies);
+  if (!supabase) {
+    return jsonResponse(500, { error: "Supabase nie jest skonfigurowany." });
+  }
+
+  const row = await saveNamedFilter(supabase, user.id, body.name, body.criteria);
+  return jsonResponse(201, { filter: row });
+};
