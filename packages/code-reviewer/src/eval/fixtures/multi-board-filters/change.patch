+import type { ApplicationStatus, WorkMode } from "@/lib/validation/applications";
+
+const STATUS_SHORT_LABELS: Record<ApplicationStatus, string> = {
+  Interesujące: "Nowe",
+  Zaaplikowano: "Wysłane",
+  Rozmowa: "W toku",
+};
+
+const WORK_MODE_ICONS: Record<WorkMode, string> = {
+  Zdalna: "🏠",
+  Hybrydowa: "🏢🏠",
+  Stacjonarna: "🏢",
+};
+
+export function shortStatusLabel(status: ApplicationStatus): string {
+  return STATUS_SHORT_LABELS[status];
+}
+
+export function workModeIcon(mode: WorkMode): string {
+  return WORK_MODE_ICONS[mode];
+}
+
+export function formatFilterSummary(statuses: ApplicationStatus[], workModes: WorkMode[]): string {
+  const parts: string[] = [];
+  if (statuses.length > 0) {
+    parts.push(statuses.map(shortStatusLabel).join(", "));
+  }
+  if (workModes.length > 0) {
+    parts.push(workModes.map(workModeIcon).join(" "));
+  }
+  return parts.length > 0 ? parts.join(" · ") : "Wszystkie";
+}
diff --git a/src/lib/services/board-filters.ts b/src/lib/services/board-filters.ts
new file mode 100644
index 0000000..8f2fcda
--- /dev/null
+++ b/src/lib/services/board-filters.ts
@@ -0,0 +1,51 @@
+import type { createClient } from "@/lib/supabase";
+import type { BoardFilterCriteria } from "@/lib/board-filter-query";
+
+type Client = NonNullable<ReturnType<typeof createClient>>;
+
+export interface SavedFilterRow {
+  id: string;
+  user_id: string;
+  name: string;
+  criteria: BoardFilterCriteria;
+  last_used_at: string | null;
+  created_at: string;
+}
+
+export async function listFilterOptions(
+  supabase: Client,
+  userId: string,
+): Promise<{ statuses: string[]; workModes: string[] }> {
+  const { data, error } = await supabase
+    .from("applications")
+    .select("status, work_mode")
+    .eq("user_id", userId)
+    .is("archived_at", null);
+
+  if (error) throw error;
+
+  const statuses = [...new Set(data.map((row) => row.status))];
+  const workModes = [...new Set(data.map((row) => row.work_mode).filter((mode): mode is string => mode !== null))];
+  return { statuses, workModes };
+}
+
+export async function saveNamedFilter(
+  supabase: Client,
+  userId: string,
+  name: string,
+  criteria: BoardFilterCriteria,
+): Promise<SavedFilterRow> {
+  const { data, error } = await supabase
+    .from("saved_filters")
+    .insert({ user_id: userId, name, criteria })
+    .select("*")
+    .single();
+
+  if (error) throw error;
+
+  // Best-effort recency bump so the filter picker can surface the most recently used
+  // filter first — not on the critical path for saving, so we don't hold up the response.
+  supabase.from("saved_filters").update({ last_used_at: new Date().toISOString() }).eq("id", data.id);
+
+  return data;
+}
