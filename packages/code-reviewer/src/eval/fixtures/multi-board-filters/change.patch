+import { useState } from "react";
+import { Button } from "@/components/ui/button";
+import { cn } from "@/lib/utils";
+import { applicationStatusValues, workModeValues } from "@/lib/validation/applications";
+import type { ApplicationStatus, WorkMode } from "@/lib/validation/applications";
+
+interface Props {
+  onApply: (statuses: ApplicationStatus[], workModes: WorkMode[]) => void;
+}
+
+export default function FilterPanel({ onApply }: Props) {
+  const [statuses, setStatuses] = useState<ApplicationStatus[]>([]);
+  const [workModes, setWorkModes] = useState<WorkMode[]>([]);
+
+  const toggleStatus = (status: ApplicationStatus) => {
+    setStatuses((prev) => (prev.includes(status) ? prev.filter((s) => s !== status) : [...prev, status]));
+  };
+
+  const toggleWorkMode = (mode: WorkMode) => {
+    setWorkModes((prev) => (prev.includes(mode) ? prev.filter((m) => m !== mode) : [...prev, mode]));
+  };
+
+  return (
+    <div className="flex flex-col gap-3 rounded-md border p-3">
+      <fieldset className="flex flex-wrap gap-2">
+        <legend className="text-sm font-medium">Status</legend>
+        {applicationStatusValues.map((status) => (
+          <button
+            key={status}
+            type="button"
+            onClick={() => toggleStatus(status)}
+            className={cn(
+              "rounded-full border px-3 py-1 text-sm",
+              statuses.includes(status) ? "border-primary bg-primary text-primary-foreground" : "border-muted",
+            )}
+          >
+            {status}
+          </button>
+        ))}
+      </fieldset>
+      <fieldset className="flex flex-wrap gap-2">
+        <legend className="text-sm font-medium">Tryb pracy</legend>
+        {workModeValues.map((mode) => (
+          <button
+            key={mode}
+            type="button"
+            onClick={() => toggleWorkMode(mode)}
+            className={cn(
+              "rounded-full border px-3 py-1 text-sm",
+              workModes.includes(mode) ? "border-primary bg-primary text-primary-foreground" : "border-muted",
+            )}
+          >
+            {mode}
+          </button>
+        ))}
+      </fieldset>
+      <Button size="sm" onClick={() => onApply(statuses, workModes)}>
+        Zastosuj filtr
+      </Button>
+    </div>
+  );
+}
