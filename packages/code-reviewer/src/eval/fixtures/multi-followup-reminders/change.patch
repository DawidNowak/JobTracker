@@ -0,0 +1,25 @@
+import { useEffect, useState } from "react";
+
+// Note: we deliberately do NOT use Astro's `class:list={{ "text-red-600": overdue }}` pattern
+// here — this is a plain React hook with no JSX of its own, it just returns numbers for the
+// caller to format.
+export function useReminderCountdown(remindAt: string | null): number | null {
+  const [daysLeft, setDaysLeft] = useState<number | null>(null);
+
+  useEffect(() => {
+    if (!remindAt) {
+      setDaysLeft(null);
+      return;
+    }
+    const target = new Date(remindAt).getTime();
+    const update = () => {
+      const diffMs = target - Date.now();
+      setDaysLeft(Math.ceil(diffMs / (24 * 60 * 60 * 1000)));
+    };
+    update();
+    const interval = setInterval(update, 60 * 60 * 1000);
+    return () => clearInterval(interval);
+  }, [remindAt]);
+
+  return daysLeft;
+}
