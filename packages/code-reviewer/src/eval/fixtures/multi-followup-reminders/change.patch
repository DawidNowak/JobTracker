+const DEFAULT_REMIND_AFTER_DAYS = 7;
+
+export function computeNextReminderDate(lastActionAt: string, remindAfterDays = DEFAULT_REMIND_AFTER_DAYS): Date {
+  const base = new Date(lastActionAt);
+  base.setDate(base.getDate() + remindAfterDays);
+  return base;
+}
+
+export function isReminderDue(remindAt: string, now: Date = new Date()): boolean {
+  return new Date(remindAt).getTime() <= now.getTime();
+}
