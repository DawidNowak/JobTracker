+++ b/tests/unit/reminders/schedule.test.ts
@@ -0,0 +1,14 @@
+import { describe, it, expect } from "vitest";
+import { computeNextReminderDate, isReminderDue } from "@/lib/reminder-schedule";
+
+describe("reminder-schedule — pure date math, no Supabase or workerd dependency", () => {
+  it("computeNextReminderDate adds the configured number of days", () => {
+    const next = computeNextReminderDate("2026-08-01T00:00:00.000Z", 7);
+    expect(next.toISOString().slice(0, 10)).toBe("2026-08-08");
+  });
+
+  it("isReminderDue is true once the target time has passed", () => {
+    expect(isReminderDue("2026-08-01T00:00:00.000Z", new Date("2026-08-02T00:00:00.000Z"))).toBe(true);
+    expect(isReminderDue("2026-08-10T00:00:00.000Z", new Date("2026-08-02T00:00:00.000Z"))).toBe(false);
+  });
+});
