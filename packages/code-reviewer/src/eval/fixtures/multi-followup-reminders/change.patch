@@ -0,0 +1,73 @@
+import type { APIRoute } from "astro";
+import { createClient } from "@/lib/supabase";
+import { jsonResponse, formatZodErrors } from "@/lib/http";
+import { reminderCreateSchema } from "@/lib/validation/reminders";
+
+export const prerender = false;
+
+export const GET: APIRoute = async (context) => {
+  const user = context.locals.user;
+  if (!user) {
+    return jsonResponse(401, { error: "Brak autoryzacji." });
+  }
+
+  const applicationId = context.params.id;
+  const supabase = createClient(context.request.headers, context.cookies);
+  if (!supabase) {
+    return jsonResponse(500, { error: "Supabase nie jest skonfigurowany." });
+  }
+
+  const { data, error } = await supabase
+    .from("follow_up_reminders")
+    .select("id, remind_at, dismissed_at")
+    .eq("application_id", applicationId)
+    .eq("user_id", user.id)
+    .order("remind_at", { ascending: true });
+
+  if (error) {
+    return jsonResponse(500, { error: "Nie udało się pobrać przypomnień." });
+  }
+
+  return jsonResponse(200, { reminders: data });
+};
+
+export const POST: APIRoute = async (context) => {
+  const user = context.locals.user;
+  if (!user) {
+    return jsonResponse(401, { error: "Unauthorized." });
+  }
+
+  const applicationId = context.params.id;
+  if (!applicationId) {
+    return jsonResponse(400, { error: "Missing application id." });
+  }
+
+  let body: unknown;
+  try {
+    body = await context.request.json();
+  } catch {
+    return jsonResponse(400, { error: "Invalid request body." });
+  }
+
+  const parsed = reminderCreateSchema.safeParse(body);
+  if (!parsed.success) {
+    return jsonResponse(422, { errors: formatZodErrors(parsed.error) });
+  }
+
+  const supabase = createClient(context.request.headers, context.cookies);
+  if (!supabase) {
+    return jsonResponse(500, { error: "Supabase is not configured." });
+  }
+
+  const { data, error } = await supabase
+    .from("follow_up_reminders")
+    .insert({ application_id: applicationId, user_id: user.id, remind_at: parsed.data.remindAt })
+    .select("id, remind_at, dismissed_at")
+    .single();
+
+  if (error) {
+    return jsonResponse(500, { error: "Could not save reminder." });
+  }
+
+  return jsonResponse(201, { reminder: data });
+};
