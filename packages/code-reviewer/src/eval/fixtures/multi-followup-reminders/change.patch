+import { useEffect, useState } from "react";
+import { isReminderDue } from "@/lib/reminder-schedule";
+
+interface ReminderSummary {
+  id: string;
+  remindAt: string;
+  dismissedAt: string | null;
+}
+
+interface ReminderBadge {
+  label: string;
+  className: string;
+}
+
+export function useReminderBadge(applicationId: string): ReminderBadge | null {
+  const [reminder, setReminder] = useState<ReminderSummary | null>(null);
+
+  useEffect(() => {
+    let cancelled = false;
+    fetch(`/api/applications/${applicationId}/reminders`)
+      .then((res) => (res.ok ? res.json() : null))
+      .then((data: { reminders?: ReminderSummary[] } | null) => {
+        if (cancelled || !data?.reminders) return;
+        const active = data.reminders.find((r) => r.dismissedAt === null) ?? null;
+        setReminder(active);
+      })
+      .catch(() => {
+        if (!cancelled) setReminder(null);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [applicationId]);
+
+  if (!reminder) return null;
+
+  const due = isReminderDue(reminder.remindAt);
+  const base = "rounded-full px-2 py-0.5 text-xs font-medium";
+  const className = due ? base + " bg-red-100 text-red-700" : base + " bg-amber-100 text-amber-700";
+
+  return { label: due ? "Czas na follow-up" : "Zaplanowano przypomnienie", className };
+}
