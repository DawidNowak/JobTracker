{
  "name": "@jobtracker/code-reviewer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Claude Agent SDK code reviewer for the JobTracker branch diff",
  "scripts": {
    "review": "tsx src/index.ts",
    "eval": "tsx src/eval/run.ts",
    "eval:check": "tsx src/eval/check.ts",
    "eval:report": "tsx src/eval/report.ts",
    "eval:replay": "tsx src/eval/replay.ts",
    "eval:prompt": "promptfoo eval -c promptfoo/promptfooconfig.yaml",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.98",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "promptfoo": "^0.122.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
